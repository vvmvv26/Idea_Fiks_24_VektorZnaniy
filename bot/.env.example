# Скопируйте этот файл в .env и впишите токен. Файл .env в репозиторий не коммитится.

# Токен бота МАКС: диалог с @MasterBot, команда /create
MAX_BOT_TOKEN=

# Локальная модель через Ollama (необязательно). Если Ollama не запущена или модель не скачана,
# бот это видит сам и работает без ИИ: выдаёт промт и кнопки бесплатных веб-чатов.
# LLM_API_KEY=ollama — не секрет, Ollama его не проверяет. Пустое значение полностью выключает ИИ.
LLM_API_KEY=ollama
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
